{
  "manifest_version": 3,
  "name": "Send to Other Browser",
  "version": "0.4.0",
  "description": "Send selected tabs to another installed browser.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Send selected tabs to another browser",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
